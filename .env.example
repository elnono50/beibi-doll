# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor. NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Dominio final, sin barra al final (ej. https://beibidoll.com.ar)
NEXT_PUBLIC_SITE_URL=

# Mercado Pago (Tus integraciones > Credenciales de producción)
MP_ACCESS_TOKEN=
# Tus integraciones > Webhooks > Clave secreta (evento: Pagos)
MP_WEBHOOK_SECRET=

# Mails (Resend). Sin estas variables la tienda funciona igual, sin mails.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend, ej: Beibi Doll <hola@beibidoll.com.ar>
EMAIL_FROM=
# A dónde responden las clientas (opcional), ej: el Gmail de la tienda
EMAIL_REPLY_TO=
# Quién recibe los avisos de pedidos nuevos (separar con coma)
ADMIN_NOTIFY_EMAIL=

# Correo Argentino (MiCorreo) para cotizar en tiempo real. Opcional: sin estas
# variables se usan sólo las tarifas por provincia y peso del panel.
# Las credenciales de la API se piden a Correo Argentino.
CORREO_API_USER=
CORREO_API_PASSWORD=
CORREO_CUSTOMER_ID=
# Opcional: https://apitest.correoargentino.com.ar/micorreo/v1 para pruebas
CORREO_API_URL=

# Lo usa Vercel Cron para mantener activo Supabase (cualquier texto largo al azar)
CRON_SECRET=

# Cupo diario de mails del plan de Resend (gratis = 100). Con plan pago poné 0 (sin tope).
# Las novedades usan sólo lo que sobra y dejan 25 libres para mails de compras.
EMAIL_DAILY_LIMIT=100

# Anti-bots invisible (Cloudflare Turnstile). Opcional pero recomendado.
# dash.cloudflare.com > Turnstile > Add widget (modo "Invisible" / Managed) con el dominio de la tienda.
# La misma Secret Key se carga también en Supabase > Authentication > Attack Protection > CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: texto largo al azar para resumir las IPs del límite de intentos
RATE_LIMIT_SALT=
